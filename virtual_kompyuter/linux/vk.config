# vk.config — Linux yadrosi uchun bizning sozlamalar (tinyconfig ustiga qo'shiladi).
# Har qator: CONFIG_NOMI=y (yoqish), =n (o'chirish) yoki qiymat. Linux ~20 000 ta sozlamaga ega;
# "tinyconfig" — eng kichigi, biz faqat kerakli narsalarni yoqamiz.

# protsessor: 32 bit, virtual xotira (Sv32), bitta yadro, suzuvchi nuqta yo'q, C kengaytmasi bor
CONFIG_ARCH_RV32I=y
CONFIG_MMU=y
CONFIG_SMP=n
CONFIG_FPU=n
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_ZICBOZ=n
CONFIG_RISCV_ISA_SVNAPOT=n
CONFIG_RISCV_ISA_SVPBMT=n
CONFIG_RISCV_ALTERNATIVE=n
CONFIG_NONPORTABLE=y
CONFIG_EFI=n

# firmware bilan aloqa (SBI): eski konsol, erta konsol (earlycon=sbi)
CONFIG_RISCV_SBI_V01=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y

# konsol: 16550 UART (bizning emulyatordagi "ns16550a")
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_VT=n
CONFIG_DUMMY_CONSOLE=n
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1

# uzilishlar va taymer: PLIC (tashqi), riscv-timer (SBI set_timer orqali)
CONFIG_SIFIVE_PLIC=y
CONFIG_RISCV_TIMER=y

# fayl tizimi: yadro ichiga tikilgan initramfs (/init va /bin/salom), /proc, /sys, /dev
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="initramfs.list"
CONFIG_RD_GZIP=n
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_KALLSYMS=y

# buyruq qatori: erta konsol SBI orqali, keyin ttyS0 (UART)
CONFIG_CMDLINE="earlycon=sbi console=ttyS0 loglevel=7"
CONFIG_CMDLINE_FORCE=y
CONFIG_PANIC_TIMEOUT=-1
